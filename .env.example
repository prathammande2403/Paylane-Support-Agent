# =====================================================================
# Paylane AI Support Agent - Environment Configuration Template
# Copy this file to .env and configure your keys.
# DO NOT commit .env with real secret keys.
# =====================================================================

# Groq API Configuration (Required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Paylane Tool Service Configuration
# If PAYLANE_API_URL is left empty, the agent connects directly to the
# in-process FastAPI application via Starlette ASGI transport (zero external hops).
# Set this to a remote URL (e.g., https://paylane-agent.onrender.com) for distributed deployments.
PAYLANE_API_URL=

# CORS Security (Comma-separated list of allowed origins, no wildcard allowed)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=paylane-support-agent
